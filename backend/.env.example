# Environment Variables for The Dormammu Loop Backend

# Port for Express API server
PORT=4000

# Allowed CORS origin (Vite frontend default)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string
# Local Docker (default from docker-compose.yml):
DATABASE_URL="postgresql://dormammu:dormammupassword@localhost:5432/dormammu_loop?schema=public"

# If using Neon (cloud Postgres):
# DATABASE_URL="postgresql://<user>:<password>@<ep-name>.neon.tech/dormammu_loop?sslmode=require"

# Redis connection string
# Local Docker (default from docker-compose.yml):
REDIS_URL="redis://localhost:6379"

# If using Upstash (cloud Redis):
# REDIS_URL="rediss://default:<password>@<endpoint>.upstash.io:6379"
